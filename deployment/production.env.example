# ==============================================================================
# GrantLoop Production Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# Copy this file to `.env` or `production.env` on your production server
# and replace all placeholder values with real production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Set the Django settings module to the production configuration.
DJANGO_SETTINGS_MODULE=grantloop.settings.prod

# Cryptographic secret key used for session signing, token generation, etc.
# Must be a long, randomly generated, and highly secure string.
SECRET_KEY=generate_a_secure_random_string_here_and_keep_it_secret

# Disable debug mode in production. NEVER set this to True in production!
DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve.
# Example: grantloop.com,www.grantloop.com,api.grantloop.com
ALLOWED_HOSTS=grantloop.com,www.grantloop.com,api.grantloop.com

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for the production PostgreSQL database.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://grantloop_user:secure_db_password_here@postgres:5432/grantloop_prod

# Maximum age (in seconds) of database connections (connection pooling).
CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# Redis & Celery Infrastructure
# ------------------------------------------------------------------------------
# URL for the primary Redis cluster used for caching and session management.
REDIS_URL=redis://redis:6379/0

# Celery Message Broker configuration (usually same as Redis caching).
CELERY_BROKER_URL=redis://redis:6379/1

# Celery Result Backend configuration.
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
# SMTP server endpoint for sending transactional emails.
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@grantloop.com
EMAIL_HOST_PASSWORD=secure_smtp_password_here

# ------------------------------------------------------------------------------
# Observability & Monitoring (Sentry)
# ------------------------------------------------------------------------------
# Sentry Data Source Name (DSN) for error tracking and performance monitoring.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & Razorpay)
# ------------------------------------------------------------------------------
# Stripe API Keys (for international payments and payouts).
STRIPE_SECRET_KEY=sk_live_replace_this_with_real_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_this_with_real_webhook_secret

# Razorpay API Keys (for India domestic payments).
RAZORPAY_KEY_ID=rzp_live_replace_this_with_real_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_this_with_real_razorpay_secret

# ------------------------------------------------------------------------------
# Security & CORS Configurations
# ------------------------------------------------------------------------------
# Comma-separated list of origins that are authorized to make cross-site HTTP requests.
# Example: https://grantloop.com,https://app.grantloop.com
CORS_ALLOWED_ORIGINS=https://grantloop.com,https://app.grantloop.com,https://www.grantloop.com

# Comma-separated list of trusted origins for CSRF protection.
CSRF_TRUSTED_ORIGINS=https://grantloop.com,https://api.grantloop.com

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Minimum log level for application loggers (DEBUG, INFO, WARNING, ERROR, CRITICAL).
DJANGO_LOG_LEVEL=INFO
