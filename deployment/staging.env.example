# ==============================================================================
# GrantLoop Staging Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# Copy this file to `.env` or `staging.env` on your staging server
# and replace all placeholder values with staging credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Set the Django settings module to the production/staging configuration.
DJANGO_SETTINGS_MODULE=grantloop.settings.prod

# Cryptographic secret key. Use a different key than production.
SECRET_KEY=generate_a_secure_random_staging_string_here

# Disable debug mode even in staging to mirror production conditions.
DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve.
ALLOWED_HOSTS=staging.grantloop.com,api-staging.grantloop.com

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for the staging PostgreSQL database.
DATABASE_URL=postgres://grantloop_staging_user:staging_db_password_here@postgres:5432/grantloop_staging

# Maximum age (in seconds) of database connections (connection pooling).
CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# Redis & Celery Infrastructure
# ------------------------------------------------------------------------------
# URL for the primary Redis cluster used for caching and session management.
REDIS_URL=redis://redis:6379/0

# Celery Message Broker configuration.
CELERY_BROKER_URL=redis://redis:6379/1

# Celery Result Backend configuration.
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
# SMTP server endpoint for sending transactional emails (can use Mailtrap/Mailhog for staging).
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=staging_smtp_user
EMAIL_HOST_PASSWORD=staging_smtp_password

# ------------------------------------------------------------------------------
# Observability & Monitoring (Sentry)
# ------------------------------------------------------------------------------
# Sentry Data Source Name (DSN) for error tracking and performance monitoring.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=staging

# ------------------------------------------------------------------------------
# Payment Gateways (Stripe & Razorpay)
# ------------------------------------------------------------------------------
# Stripe API Keys (use Stripe TEST mode keys for staging).
STRIPE_SECRET_KEY=sk_test_replace_this_with_real_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_this_with_real_test_webhook_secret

# Razorpay API Keys (use Razorpay TEST mode keys for staging).
RAZORPAY_KEY_ID=rzp_test_replace_this_with_real_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_this_with_real_razorpay_test_secret

# ------------------------------------------------------------------------------
# Security & CORS Configurations
# ------------------------------------------------------------------------------
# Comma-separated list of origins that are authorized to make cross-site HTTP requests.
CORS_ALLOWED_ORIGINS=https://staging.grantloop.com,https://app-staging.grantloop.com

# Comma-separated list of trusted origins for CSRF protection.
CSRF_TRUSTED_ORIGINS=https://staging.grantloop.com,https://api-staging.grantloop.com

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Minimum log level for application loggers (DEBUG, INFO, WARNING, ERROR, CRITICAL).
DJANGO_LOG_LEVEL=INFO
